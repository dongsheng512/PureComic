{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PureComic",
  "version": "0.1.0",
  "identifier": "app.comic.enhance",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PureComic",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "dragDropEnabled": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 16, "y": 18 },
        "theme": "Dark",
        "backgroundColor": "#1c1e2e"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "$TEMP/**", "$HOME/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "category": "public.app-category.graphics-design",
    "copyright": "Apache-2.0",
    "shortDescription": "PureComic — 本地漫画画质增强",
    "longDescription": "PureComic 本地优先：导入 CBZ/CBR/文件夹/EPUB/MOBI，Waifu2x 或 Real-CUGAN 增强后导出。",
    "externalBin": ["binaries/waifu2x-ncnn-vulkan"],
    "resources": [
      "resources/models-cunet",
      "resources/NOTICE",
      "resources/checksums.sha256"
    ],
    "macOS": {
      "bundleName": "PureComic",
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 },
        "windowSize": { "width": 660, "height": 400 }
      }
    }
  },
  "plugins": {}
}
