{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PureComic",
  "version": "0.2.1",
  "identifier": "app.comic.enhance",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PureComic",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "dragDropEnabled": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        },
        "backgroundColor": "#212121"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/32x32@2x.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/256x256@2x.png",
      "icons/512x512.png",
      "icons/512x512@2x.png",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "category": "public.app-category.graphics-design",
    "copyright": "Apache-2.0",
    "shortDescription": "PureComic — 本地漫画画质增强",
    "longDescription": "PureComic 本地优先：导入 CBZ/CBR/文件夹/EPUB/MOBI，Waifu2x 或 Real-CUGAN 增强后导出。",
    "externalBin": [
      "binaries/waifu2x-ncnn-vulkan",
      "binaries/realcugan-ncnn-vulkan"
    ],
    "resources": [
      "resources/models-cunet",
      "resources/models-se",
      "resources/models-pro",
      "resources/models-nose",
      "resources/waifu2x-coreml",
      "resources/realesrgan-coreml",
      "resources/NOTICE",
      "resources/checksums.sha256"
    ],
    "macOS": {
      "bundleName": "PureComic",
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "cbz",
          "cbr",
          "zip",
          "rar"
        ],
        "name": "Comic Archive",
        "description": "Comic book archive",
        "role": "Viewer",
        "mimeType": "application/vnd.comicbook+zip"
      },
      {
        "ext": [
          "epub",
          "mobi",
          "azw",
          "azw3"
        ],
        "name": "Ebook",
        "description": "Ebook for comic reading",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {}
}